.blog-list
  list-style none
  padding-left 0

.blog-item
  padding-bottom 1.5rem
  margin-bottom 1.5rem
  border-bottom 1px solid $borderColor

  &:last-child
    border-bottom none

  h2
    border-bottom none
    padding-bottom 0
    margin-bottom 0.25rem
    font-size 1.4rem

.blog-meta
  color #999
  font-size 0.85rem
  margin-top 0
